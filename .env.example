# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET:
# Configure for live Razorpay payment gateway checkout & server-side HMAC-SHA256 verification.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# NOTIFICATION_WEBHOOK_URL:
# Optional webhook endpoint (e.g., Twilio/MSG91/WhatsApp/SMTP relay) for order SMS/WhatsApp/Email dispatch.
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_TOKEN=""
